# ---------------------------------------------------------------------------
# Scriptoria — configuration locale
#
# `make up` copie ce fichier en `.env` s'il n'existe pas.
# `.env` est gitignoré. AUCUN secret réel ici : la stack est locale et isolée.
# ---------------------------------------------------------------------------

# --- Postgres : source de vérité (documents, pages, révisions, jobs) --------
POSTGRES_USER=scriptoria
POSTGRES_PASSWORD=scriptoria
POSTGRES_DB=scriptoria
DATABASE_URL=postgresql+asyncpg://scriptoria:scriptoria@postgres:5432/scriptoria

# --- Redis : broker du worker arq ------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Elasticsearch : index de recherche (reconstructible via `make reindex`) -
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=scriptoria-chunks
# Heap plafonné : la VM Docker ne dispose que de 8 Go sur cette machine.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- Ollama : HORS Docker, sur l'hôte --------------------------------------
# Docker Desktop sur macOS n'expose pas le GPU Metal aux conteneurs. Un Ollama
# conteneurisé tournerait en CPU pur (5 à 10x plus lent), inexploitable pour de
# l'OCR vision. Ollama tourne donc nativement et les conteneurs le joignent ici.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_GENERATION_MODEL=mistral:latest
# Fenêtre de génération, en jetons. Sans elle Ollama garde 4 096 jetons et coupe
# le début du prompt (règles et meilleurs passages) sans erreur. Les passages
# sont limités pour tenir dans NUM_CTX - NUM_PREDICT. 8 192 jetons coûtent
# ~0,5 Go de cache de plus que 4 096 pour mistral 7B (estimation).
OLLAMA_GENERATION_NUM_CTX=8192
OLLAMA_GENERATION_NUM_PREDICT=512
# Dimension des vecteurs bge-m3. Doit correspondre au mapping ES dense_vector.
EMBEDDING_DIM=1024
# Délai généreux : l'OCR vision d'une page peut dépasser la minute sur M4.
OLLAMA_TIMEOUT_SECONDS=300

# Machine à 16 Go unifiés : ne jamais garder deux modèles chargés en parallèle.
# À exporter dans le shell qui lance `ollama serve`, pas lu par les conteneurs.
# OLLAMA_MAX_LOADED_MODELS=1

# --- Confiance : double passage sélectif ------------------------------------
# Un second passage double le coût d'une page (~57 s de plus). Il ne se déclenche
# que si les contrôles gratuits (cohérence arithmétique, structure) ont fait
# tomber le score de la page sous ce seuil. À 0.0, jamais de second passage.
CONFIDENCE_SECOND_PASS_THRESHOLD=0.5
# Doit rester non nulle : à température 0, le second passage redonnerait mot pour
# mot la même sortie et ne mesurerait aucune divergence.
CONFIDENCE_SECOND_PASS_TEMPERATURE=0.4

# --- Application ------------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=/data
API_BASE_URL=http://api:8000
